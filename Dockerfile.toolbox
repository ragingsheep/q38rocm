FROM registry.fedoraproject.org/fedora-minimal:44

LABEL maintainer="q38rocm-toolbox"
LABEL description="Q38 ROCmFPX Toolbx for AMD Strix Halo"

ENV HSA_OVERRIDE_GFX_VERSION=11.5.1
ENV GGML_HIP_ENABLE_UNIFIED_MEMORY=1
ENV HIP_VISIBLE_DEVICES=0
ENV ROCM_FLUSH_ACCEPT=1

ENV AMD_VULKAN_ICD=RADV
ENV RADV_PERFTEST="gpl,sam,nggc"

ENV PATH="/app/engine/bin:${PATH}"
ENV LD_LIBRARY_PATH="/app/engine/bin:${LD_LIBRARY_PATH}"

WORKDIR /app

RUN microdnf -y --nodocs --setopt=install_weak_deps=0 install \
    bash \
    ca-certificates \
    curl \
    git \
    libatomic \
    libstdc++ \
    libgcc \
    libgomp \
    libibverbs \
    vulkan-loader \
    vulkan-loader-devel \
    vulkan-tools \
    mesa-vulkan-drivers \
    radeontop \
    procps-ng \
    pciutils \
    python3 \
    python3-pip \
    tar \
    gzip \
    && microdnf clean all \
    && rm -rf /var/cache/dnf/*

# Download Julian's ROCmFPX engine
RUN mkdir -p /app/engine && \
    curl -fL \
      "https://github.com/julianmb/q38rocm/releases/download/v1.0.0/strix-halo-rocmfpx-engine-v1.0.0-linux-x86_64.tar.gz" \
      -o /tmp/engine.tar.gz && \
    echo "bbc7845db0c012b97f1c9b8a2733a7083c6f9a749a453866fbe1994151d3364f  /tmp/engine.tar.gz" \
      | sha256sum -c - && \
    echo "Extracting ROCmFPX engine..." && \
    tar -xvzf /tmp/engine.tar.gz -C /tmp/ && \
    echo "Installing ROCmFPX engine..." && \
    cp -a /tmp/strix-halo-rocmfpx-engine/. /app/engine/ && \
    rm -rf /tmp/strix-halo-rocmfpx-engine /tmp/engine.tar.gz

COPY requirements.txt /app/

RUN pip3 install --no-cache-dir -r /app/requirements.txt || true

COPY . /app/

RUN chmod +x /app/*.sh \
    /app/scripts/*.sh \
    /app/scripts/*.py

CMD ["/bin/bash"]
